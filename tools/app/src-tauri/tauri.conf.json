{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "xs16keymap",
  "version": "1.0.0",
  "identifier": "com.xs16.keymap-tool",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run build",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "XS16 键位映射编辑器",
        "width": 960,
        "height": 760,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "dialog": null,
    "fs": null
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "dmg", "msi", "nsis"],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}